+// Luanti
+// SPDX-License-Identifier: LGPL-2.1-or-later
+//
+// Native voice chat for the Simple Voice Chat client fork.
+//
+// This module owns its own OpenAL playback context and capture device, encodes
+// microphone audio with Opus, sends it over UDP to the voice relay, and renders
+// the relay's forwarded audio as 3D sources. The main Luanti sound manager is
+// deliberately not involved: voice needs a continuous stream, not sound files.
+
+#pragma once
+
+#include "config.h"
+#include "irr_v3d.h"
+#include "network/address.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+#if USE_SOUND
+#include <AL/al.h>
+#include <AL/alc.h>
+#include <opus.h>
+#endif
+
+class UDPSocket;
+
+class VoiceChat
+{
+public:
+	VoiceChat();
+	~VoiceChat();
+
+	/// Opens the audio devices and starts the network thread. The connection
+	/// itself is asynchronous; isConnected() becomes true on WELCOME.
+	bool start(const std::string &host, uint16_t port, const std::string &token,
+			std::string *error = nullptr);
+	void stop();
+
+	/// Called from the game loop. The listener is the camera, in node space.
+	void update(f32 dtime, const v3f &listener_pos, const v3f &listener_dir,
+			const v3f &listener_up);
+	void setPushToTalk(bool pressed);
+
+	/// Native control message from the server mod (currently a join token).
+	void onControlMessage(const std::string &message);
+
+	bool isConnected() const { return m_connected.load(); }
+	bool isTransmitting() const { return m_transmitting.load(); }
+	std::string statusText() const;
+
+private:
+	void threadMain();
+	bool initAudio(std::string &error);
+	void cleanupAudio();
+	void processFrame(const int16_t *samples);
+	void sendHello();
+	void sendAudio(const uint8_t *data, size_t size);
+	void sendState();
+	void sendPing();
+	void receivePackets();
+	void handlePacket(const uint8_t *data, size_t size);
+	void playAudio(uint32_t sender_id, uint32_t sequence, const float pos[3],
+			const std::string &name, const uint8_t *data, size_t size);
+	void updateListener();
+	void cleanupSpeakers();
+	void setStatus(const std::string &status);
+	bool parseControl(const std::string &message, std::string &token,
+			std::string &host, uint16_t &port);
+
+	std::atomic<bool> m_thread_stop{false};
+	std::atomic<bool> m_connected{false};
+	std::atomic<bool> m_transmitting{false};
+	std::atomic<bool> m_ptt{false};
+	std::atomic<bool> m_push_to_talk_mode{true};
+	std::atomic<float> m_threshold{0.02f};
+	std::atomic<float> m_input_gain{1.0f};
+	std::atomic<float> m_output_volume{1.0f};
+	std::atomic<bool> m_state_dirty{true};
+	std::atomic<uint32_t> m_session_id{0};
+	std::atomic<uint32_t> m_sequence{0};
+	std::atomic<uint64_t> m_last_state_ms{0};
+	std::atomic<uint64_t> m_last_ping_ms{0};
+
+	mutable std::mutex m_mutex;
+	v3f m_listener_pos{0, 0, 0};
+	v3f m_listener_dir{0, 0, 1};
+	v3f m_listener_up{0, 1, 0};
+	std::string m_status;
+	std::string m_host;
+	uint16_t m_port = 0;
+	std::string m_token;
+	Address m_relay_address;
+	std::unique_ptr<UDPSocket> m_socket;
+
+	std::mutex m_init_mutex;
+	std::condition_variable m_init_cv;
+	bool m_init_done = false;
+	bool m_init_ok = false;
+	std::string m_init_error;
+
+#if USE_SOUND
+	ALCdevice *m_capture_device = nullptr;
+	ALCdevice *m_playback_device = nullptr;
+	ALCcontext *m_playback_context = nullptr;
+	OpusEncoder *m_encoder = nullptr;
+
+	struct Speaker {
+		ALuint source = 0;
+		OpusDecoder *decoder = nullptr;
+		uint32_t last_sequence = 0;
+		uint64_t last_packet_ms = 0;
+		std::string name;
+	};
+	std::unordered_map<uint32_t, Speaker> m_speakers;
+#endif
+};
